# ---------- Walrus Memory (MemWal) — Sui MAINNET ----------
# Create at https://memory.walrus.xyz/dashboard (connect your own Sui wallet).
# MEMWAL_PRIVATE_KEY = the delegate private key shown ONCE when you generate a delegate key (NOT your wallet seed phrase).
MEMWAL_PRIVATE_KEY=
# MEMWAL_ACCOUNT_ID = the MemWalAccount object id (0x...) from the dashboard.
MEMWAL_ACCOUNT_ID=
# Mainnet managed relayer (default). Testnet: https://relayer-staging.memory.walrus.xyz
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
MEMWAL_NAMESPACE=tipster-ledger
# Optional, display only: the delegate PUBLIC key hex (= MEMWAL_AGENT_ID on the hackathon form).
MEMWAL_AGENT_ID=
# Optional, for onchain verification: your Sui wallet address that owns the MemWal account.
MEMWAL_OWNER_ADDRESS=

# Memory backend: "auto" (MemWal when the two keys above are set, else local), "memwal", or "local".
MEMORY_BACKEND=auto

# ---------- Tatum (Sui RPC gateway) ----------
# Free key at https://dashboard.tatum.io . Without a key the gateway works keyless but is heavily rate-limited.
TATUM_API_KEY=
TATUM_SUI_RPC_URL=https://sui-mainnet.gateway.tatum.io

# Pyth SUI/USD PriceInfoObject on Sui mainnet (read via Tatum to settle "markets" picks).
PYTH_SUI_USD_OBJECT_ID=0x801dbc2f0053d34734814b2d6df491ce7807a725fe9a01ad74a07e9c51396c37
